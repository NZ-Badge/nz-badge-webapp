# Database — required for all environments
# Inside ddev: mysql://db:db@db/db
# Outside ddev: mysql://db:db@127.0.0.1:PORT/db  (see `ddev describe` for PORT)
DATABASE_URL="mysql://db:db@db/db"

# Max upload size — aumentare se i firmware .bin superano 512K (default adapter-node)
BODY_SIZE_LIMIT=5242880
