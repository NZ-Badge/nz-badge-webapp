# Database connection
# Example inside containers: mysql://db:db@db/db
# Example from host: mysql://db:db@127.0.0.1:3306/db
DATABASE_URL="mysql://db:db@db/db"

# Session signing secret for admin login cookies
# Generate a long random value before production use
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: canonical browser origin used to redirect legacy domains
PRIMARY_APP_ORIGIN="https://rp.intessere.com"

# Optional: comma-separated legacy hosts that should redirect to PRIMARY_APP_ORIGIN
LEGACY_APP_HOSTS="rp.nicolatomassoni.it"

# Optional: increase if firmware .bin uploads exceed default request limits
BODY_SIZE_LIMIT=5242880

# Optional: used only by `npm run db:seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
