# Database connection
# Example inside containers: mysql://db:db@db/db
# Example from host: mysql://db:db@127.0.0.1:3306/db
DATABASE_URL="mysql://db:db@db/db"

# Session signing secret for admin login cookies
# Generate a long random value before production use
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: canonical browser origin used to redirect legacy domains
PRIMARY_APP_ORIGIN="https://rp.intessere.com"

# Optional: comma-separated legacy hosts that should redirect to PRIMARY_APP_ORIGIN
LEGACY_APP_HOSTS="rp.nicolatomassoni.it"

# Optional: maximum compressed database import size (100 MB)
BODY_SIZE_LIMIT=104857600

# Optional: directory for the automatic safety dump taken before every database import
# (absolute or relative to the working directory; default: localfiles/backups).
# Mount it on a persistent volume in production.
DB_BACKUP_DIR="localfiles/backups"

# Optional: number of pre-import safety dumps kept in DB_BACKUP_DIR (default: 10).
# Older nz-badge-pre-import-*.sql.gz files are deleted after each new dump.
DB_BACKUP_KEEP=10

# Optional: minimum level of the JSON server logs (debug, info, warn, error; default: info)
LOG_LEVEL="info"

# Optional (adapter-node): client IP behind a reverse proxy, used by audit log and login
# rate limit. Without ADDRESS_HEADER the socket address (the proxy's) is used.
# With X-Forwarded-For set XFF_DEPTH to the number of trusted proxies in front of the app,
# so values injected by the client are ignored.
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH=1

# Optional: required only by `npm run jobs:weekly-attendance-summary` when enabled
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="NZ Badge <no-reply@example.test>"

# Optional: used only by `npm run db:seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
