{
	"name": "webapp",
	"version": "0.3.4",
	"private": true,
	"author": "Nicola Tomassoni <io@nicolatomassoni.it> (https://www.nicolatomassoni.it)",
	"homepage": "https://www.nicolatomassoni.it",
	"repository": {
		"type": "git",
		"url": "https://github.com/NZ-Badge/nz-badge-webapp.git"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:run": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:attendance-demo": "tsx scripts/seed-attendance-demo.ts",
		"jobs:weekly-attendance-summary": "tsx scripts/send-weekly-attendance-summary.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/kit": "^2.16.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/nodemailer": "^8.0.0",
		"@vite-pwa/sveltekit": "^0.4.0",
		"bits-ui": "^2.16.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.30.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.19.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.7",
		"vitest": "^3.0.4"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"drizzle-orm": "^0.39.1",
		"jose": "^5.9.6",
		"lucide-svelte": "^0.477.0",
		"mysql2": "^3.11.5",
		"node-cron": "^3.0.3",
		"nodemailer": "^8.0.9",
		"zod": "^3.24.1"
	},
	"type": "module"
}
