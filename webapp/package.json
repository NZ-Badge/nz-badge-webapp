{
	"name": "NZBadge",
	"version": "0.5.6",
	"private": true,
	"author": "Nicola Tomassoni <io@nicolatomassoni.it> (https://www.nicolatomassoni.it)",
	"homepage": "https://www.nicolatomassoni.it",
	"repository": {
		"type": "git",
		"url": "https://github.com/NZ-Badge/nz-badge-webapp.git"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:run": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:attendance-demo": "tsx scripts/seed-attendance-demo.ts",
		"jobs:weekly-attendance-summary": "tsx scripts/send-weekly-attendance-summary.ts"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/nodemailer": "^8.0.2",
		"@vite-pwa/sveltekit": "^0.4.0",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"drizzle-orm": "^0.45.3",
		"jose": "^5.10.0",
		"mysql2": "^3.24.4",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.1.1",
		"tsx": "^4.23.15",
		"zod": "^3.25.76"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"type": "module"
}
